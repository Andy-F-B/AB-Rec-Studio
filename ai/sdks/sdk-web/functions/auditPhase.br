// auditPhase.br — security, RLS, checklist verification
// call: *dev* !sdk|003| br : { run; <auditPhase> }; { run; <auditPhase>; "feature or full" } :
// arg1 = optional scope. output → [root/dev-output/] or pt

read; [root/ai/sdks/sdk-web/variables.br]
do; [root/ai/sdks/sdk-web/prompts/security-audit-prompt.md]
prompt; 'Execute audit phase. Scope (arg1): {arg1}. Run security audit and checklist verification. If security.md missing, read [root/ai/sdks/sdk-web/specs/security.md]. Output prioritized report to [root/dev-output/] or return as pt.'
